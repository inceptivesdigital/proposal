# Rename this file to  keys.env  and paste your keys after the = signs.
# No quotes. No spaces around the = sign.
# Lines starting with # are ignored.

# --- Required: writes the proposal copy -------------------------------------
ANTHROPIC_API_KEY=
PROPOSAL_MODEL=claude-opus-5

# Subject-matched photography inside generated screens. Free key from
# unsplash.com/developers. Without it real photos are still used, just not
# matched to the subject.
UNSPLASH_ACCESS_KEY=

# --- Optional: photographic UI screens --------------------------------------
# Leave these blank and the app draws the screens itself, instantly and free.
V0_API_KEY=
SCREENSHOT_PROVIDER=screenshotone
SCREENSHOT_API_KEY=

# --- Production only ---------------------------------------------------------
# With DATABASE_URL set the app uses Postgres; without it, a local SQLite file.
DATABASE_URL=
ENVIRONMENT=
COOKIE_SECURE=

# Sign-up codes. Without these the code is printed in the terminal, which is
# fine locally and must not be used in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OTP_DEV_ECHO=1

# Who may hold an account
ALLOWED_EMAIL_DOMAINS=inceptivesdigital.com
